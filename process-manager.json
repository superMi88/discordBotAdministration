{
  "name": "Discord-Suite",
  "repository": "superMi88/servernew",
  "category": "Discord Bots",
  "services": [
    {
      "name": "Discord-Bot",
      "pm2Process": "discordBot",
      "envPath": "./discordBot/.env",
      "requirements": [
        {
          "key": "DATABASE_URL",
          "label": "LiasDatabase MongoDB",
          "type": "database",
          "dbType": "mongodb",
          "description": "Verbindung zur MongoDB Datenbank (LiasDatabase)"
        },
        {
          "key": "DISCORD_CLIENT_ID",
          "label": "Discord Client ID",
          "type": "textinput",
          "description": "Discord Bot Application Client ID"
        },
        {
          "key": "DISCORD_CLIENT_SECRET",
          "label": "Discord Client Secret",
          "type": "textinput",
          "description": "Discord Bot Application Client Secret"
        }
      ]
    },
    {
      "name": "Web-Dashboard",
      "pm2Process": "website",
      "envPath": "./website/.env",
      "dependsOn": "Discord-Suite/Discord-Bot",
      "requirements": [
        {
          "key": "PORT",
          "label": "Web Port",
          "type": "port",
          "defaultValue": "3000",
          "description": "Netzwerkport für das Next.js Web-Dashboard"
        },
        {
          "key": "JWT_SECRET",
          "label": "JWT Secret",
          "type": "textinput",
          "description": "Geheimer Schlüssel zur Signierung der Authentifizierungs-Tokens"
        },
        {
          "key": "DISCORD_CLIENT_ID",
          "label": "Discord Client ID",
          "type": "textinput",
          "description": "Discord OAuth Client ID"
        },
        {
          "key": "DISCORD_CLIENT_SECRET",
          "label": "Discord Client Secret",
          "type": "textinput",
          "description": "Discord OAuth Client Secret"
        },
        {
          "key": "DATABASE_URL",
          "label": "LiasDatabase MongoDB",
          "type": "database",
          "dbType": "mongodb",
          "description": "Verbindung zur MongoDB Datenbank (LiasDatabase)"
        }
      ]
    }
  ]
}